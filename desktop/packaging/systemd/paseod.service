[Unit]
Description=Paseo Rust daemon (per-user)
Documentation=https://github.com/mintoleda/paseo-rs

[Service]
Type=simple
# SIGINT lets paseod remove its Unix socket and instance lock on shutdown.
ExecStart=%h/.local/bin/paseod
KillSignal=SIGINT
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
